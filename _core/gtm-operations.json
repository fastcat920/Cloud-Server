  "CreateCloudGtmMonitorTemplate": {
    "label": "创建探测模板",
    "kind": "monitors",
    "create": true,
    "delete": false,
    "fields": {
      "Name": {
        "type": "string",
        "label": "名称",
        "required": true
      },
      "IpVersion": {
        "type": "string",
        "label": "IP 版本",
        "required": true,
        "enum": [
          "IPv4",
          "IPv6"
        ]
      },
      "Protocol": {
        "type": "string",
        "label": "探测协议",
